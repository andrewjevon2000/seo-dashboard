# ═══════════════════════════════════════════════════════════════════════════════
# Verihubs SEO Dashboard — PRODUCTION env checklist
# ───────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   • These same key/values go into Vercel → Project → Settings → Environment
#     Variables (one per row). This file is a collection worksheet — fill values
#     in as you provision each source, then copy them into Vercel.
#   • Copy to `.env.production` to keep a filled local copy — that filename is
#     gitignored, so your secrets can never be committed. NEVER paste secrets
#     into chat; put them here or straight into Vercel.
#   • [ ] = still to obtain,  [x] = done.  Work top to bottom; each phase unblocks
#     the next.
# ═══════════════════════════════════════════════════════════════════════════════


# ── PHASE A · Minimum to boot (deploy even on fixtures) ────────────────────────

# [ ] Supabase database — POOLED connection string (Transaction pooler, port 6543).
#     Supabase → Project → Settings → Database → Connection string → "Transaction".
#     Runtime uses ONLY this (prepare:false is already set in code for the pooler).
DATABASE_URL=""

# [ ] Dashboard basic-auth. ⚠️ A BLANK PASSWORD DISABLES AUTH — the site would be
#     public. Always set a strong password in production.
DASHBOARD_USER="verihubs"
DASHBOARD_PASSWORD=""

# [ ] Cron secret — guards /api/cron/pull. Vercel sends it as the Bearer token
#     automatically once set here. Generate a long random value, e.g.:
#         openssl rand -hex 32        (or: node -e "console.log(crypto.randomUUID())")
CRON_SECRET=""

# [x] Site key — written to articles.site. Keep "verihubs" for v1.
SITE_KEY="verihubs"

# [ ] Fixtures switch. "true" = launch on built-in sample data (live URL now,
#     real data later). Set "false" once Phase B/C values below are filled.
USE_PIPELINE_FIXTURES="true"


# ── PHASE B · Real GSC data (Ahrefs + content-plan Sheet) ──────────────────────
# Set USE_PIPELINE_FIXTURES="false" once these are in.

# [ ] Ahrefs API key. ⚠️ Shares a credit (unit) pool with the monthly
#     seo-report-verihubs skill — check the balance before enabling the weekly cron.
AHREFS_API_KEY=""
# [ ] The GSC-connected Ahrefs project ID (integer).
AHREFS_PROJECT_ID=""
# [ ] Optional country filter for GSC pulls, e.g. "id" or "ph". Blank = all.
AHREFS_COUNTRY=""
# [x] Weekly pull self-skips if remaining units fall below this. 0 disables the guard.
AHREFS_CREDIT_THRESHOLD="500"

# Content-plan Sheet — choose ONE strategy (CSV wins if both are set):
#
# [ ] (A) Published CSV: Sheet → File → Share → Publish to web → CSV → paste URL.
GOOGLE_SHEET_CSV_URL=""
#
# [ ] (B) Service account: create a GCP service account, share the Sheet with its
#     email as VIEWER, then fill these. Paste the private key with literal \n.
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEET_WORKSHEET_TITLE=""

# [ ] SEPARATE MANUAL STEP (not an env var): add a "Cluster" column to the content
#     plan and backfill it. Until then the topic-cluster filter renders disabled
#     (by design). Do not auto-derive clusters from keywords/URLs.


# ── PHASE C · GA4 (Phase 2 — sessions, engagement, CTA funnel) ─────────────────
# Optional for first launch. GA4 pull is skipped entirely until GA4_PROPERTY_ID
# + a service account are present.

# [ ] Numeric GA4 property ID.
GA4_PROPERTY_ID=""
# [ ] Service account granted VIEWER under GA4 Admin → Property Access Management
#     (distinct from personal GA4 UI access). Falls back to GOOGLE_SERVICE_ACCOUNT_*
#     above if left blank.
GA4_SERVICE_ACCOUNT_EMAIL=""
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=""
# [ ] GTM CTA event name (e.g. "cta_click"). ⚠️ BLANK = CTA clicks not queried.
#     cta_clicks is NOT a GA4 default — it only has data if the Verihubs GTM
#     container fires this event on /kontak,/contact clicks. Confirm in GTM first.
GA4_CTA_EVENT_NAME=""
# [x] "true" restricts GA4 to the organic-search channel so the funnel continues
#     coherently from GSC clicks. "false" = all-traffic sessions.
GA4_ORGANIC_ONLY="true"


# ── PHASE D · Optional ─────────────────────────────────────────────────────────

# [ ] Path or URL to the cannibalization-check skill output JSON. Blank hides the
#     Cannibalization flag column.
CANNIBALIZATION_SOURCE=""


# ── NOT needed in Vercel ───────────────────────────────────────────────────────
# DIRECT_URL is only used by `drizzle-kit migrate` from your machine (direct
# connection, port 5432). Runtime never uses it — do not add it in Vercel.
#   DIRECT_URL="postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
