# ─────────────────────────────────────────────────────────────────────────────
# Verihubs SEO Dashboard — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres) --------------------------------------------
# Use the POOLED connection string (port 6543, "Transaction" pooler) for the app
# and serverless functions. Drizzle migrations can use the direct string (5432).
DATABASE_URL="postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Optional: direct (non-pooled) URL used only by drizzle-kit migrate/studio.
DIRECT_URL="postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Ahrefs API (GSC passthrough) --------------------------------------------
# Shared credit pool with the monthly seo-report-verihubs skill — mind the balance.
AHREFS_API_KEY=""
# The GSC-connected Ahrefs project ID the pipeline pulls from (integer).
AHREFS_PROJECT_ID=""
# Optional two-letter country filter for GSC pulls (e.g. "id" or "ph"). Blank = all.
AHREFS_COUNTRY=""
# Skip the weekly pull if remaining Ahrefs API units fall below this.
# Set to 0 to disable the guard. See lib/pipeline/ahrefs.ts.
AHREFS_CREDIT_THRESHOLD="500"

# --- Content plan Google Sheet (read-only source of truth) -------------------
# Choose ONE strategy:
#
# (A) Service account (recommended): share the Sheet with the SA email as Viewer.
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the private key with literal \n escapes, or point to a file path below.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# The tab/worksheet title holding the article plan (e.g. "Article Ideation PH").
GOOGLE_SHEET_WORKSHEET_TITLE=""
#
# (B) Published CSV export (simpler): File > Share > Publish to web > CSV.
# If set, this takes precedence over the service-account strategy.
GOOGLE_SHEET_CSV_URL=""

# --- GA4 (Phase 2) ------------------------------------------------------------
# Numeric GA4 property id. Absent → the GA4 pull step is skipped entirely.
GA4_PROPERTY_ID=""
# Service account granted Viewer under GA4 Admin > Property Access Management.
# (Distinct from personal GA4 UI access — must be provisioned separately.)
# Falls back to GOOGLE_SERVICE_ACCOUNT_* above if these are left blank.
GA4_SERVICE_ACCOUNT_EMAIL=""
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=""
# The GTM-configured CTA event name (e.g. "cta_click"). BLANK → CTA clicks are
# not queried. cta_clicks is NOT a GA4 default — it only has data if the Verihubs
# GTM container fires this event on /kontak,/contact link clicks. Confirm in GTM.
GA4_CTA_EVENT_NAME=""
# "true" restricts GA4 metrics to the organic-search channel so the funnel
# continues coherently from GSC clicks. "false" = all-traffic sessions.
GA4_ORGANIC_ONLY="true"

# --- Ahrefs Web Analytics (measured on-site traffic; NO GA4/client admin) ------
# Measured per-entry-page visitors via the SAME AHREFS_API_KEY + AHREFS_PROJECT_ID
# as the GSC pull. The GA4-free path to measured traffic. Stored under
# source='web_analytics' (never conflated with the GSC estimate). Cost: 0 units.
# "false" skips the step; default on when Ahrefs is configured.
WEB_ANALYTICS_ENABLED="true"
# "true" restricts measured traffic to organic search so it lines up with GSC
# clicks. "false" counts all channels.
WEB_ANALYTICS_ORGANIC_ONLY="true"

# --- Pipeline / Cron ----------------------------------------------------------
# Secret required in the Authorization header to invoke /api/cron/pull.
# Vercel Cron sends this automatically when configured as CRON_SECRET.
CRON_SECRET=""
# Site identifier written to articles.site (multi-client-ready; v1 = verihubs).
SITE_KEY="verihubs"

# --- Cannibalization flag ------------------------------------------------------
# Path (or URL) to the cannibalization-check skill output JSON, if piping it in.
# Leave blank to disable the Cannibalization risk column.
CANNIBALIZATION_SOURCE=""

# --- Dashboard auth (single shared password, HTTP Basic) ---------------------
DASHBOARD_USER="verihubs"
DASHBOARD_PASSWORD=""

# --- Local dev conveniences ---------------------------------------------------
# When "true", the pipeline uses lib/pipeline/fixtures instead of live APIs,
# so the app runs end-to-end before real credentials are wired.
USE_PIPELINE_FIXTURES="false"
