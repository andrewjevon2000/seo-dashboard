{
  "name": "verihubs-seo-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:backfill": "tsx lib/db/backfill-cli.ts",
    "db:regen-findings": "tsx lib/db/regen-findings-cli.ts",
    "db:sweep-log": "tsx lib/db/sweep-log.ts",
    "db:keyword-log": "tsx lib/db/keyword-log.ts",
    "db:canni-log": "tsx lib/db/cannibalization-log.ts",
    "db:findings-log": "tsx lib/db/findings-log.ts",
    "db:report-read": "tsx lib/db/report-reader.ts",
    "db:weekly-activity": "tsx lib/db/weekly-activity.ts",
    "db:decision": "tsx lib/db/decision.ts",
    "db:finding": "tsx lib/db/finding.ts",
    "db:status": "tsx lib/db/status.ts",
    "check": "tsc --noEmit && vitest run",
    "pipeline:run": "tsx lib/pipeline/cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^9.15.0",
    "google-spreadsheet": "^4.1.4",
    "next": "^15.5.22",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
